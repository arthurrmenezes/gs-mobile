# Endereço da API C# da Luz Vital (pasta api-csharp - link do repositório está no README).
# Sem esta variável o app usa os dados de demonstração (mock).
# No celular, troque localhost pelo IP do computador na rede, ex.: http://192.168.0.10:5131
# No emulador Android, use http://10.0.2.2:5131
EXPO_PUBLIC_API_URL=http://localhost:5131

# Endereço do serviço de pontos com energia (entrega de SOA, em C#).
# Sem esta variável, ou se o serviço não responder, a aba "Lugares" usa os dados de demonstração (mock).
# Vale a mesma regra de localhost / 10.0.2.2 / IP do computador.
EXPO_PUBLIC_PONTOS_URL=http://localhost:5132
